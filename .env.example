# Copy to .env and adjust. Both projects load this file automatically.
# Never commit the real .env — .gitignore already excludes it.

# Debug is OFF unless this is exactly "1". Set it for local development.
DJANGO_DEBUG=1

# Required whenever DJANGO_DEBUG is not 1 — startup fails without it.
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Frontend -> backend wiring
PORTFOLIO_API_BASE_URL=http://127.0.0.1:8001
PORTFOLIO_API_TIMEOUT=5.0
